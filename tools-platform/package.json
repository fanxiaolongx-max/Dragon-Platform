{
  "name": "tools-platform",
  "version": "1.0.481",
  "description": "Tools Platform Desktop App",
  "repository": "github:fanxiaolongx-max/privacy-policy",
  "main": "electron-main.js",
  "scripts": {
    "start": "node backend/server.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "start:desktop": "electron .",
    "postinstall": "electron-builder install-app-deps && node scripts/ensure-builtin-assets.js",
    "assets:ensure": "node scripts/ensure-builtin-assets.js",
    "assets:pack-audio": "node backend/builtin-tools/tool-mtakhxqm/pack-audio.mjs",
    "tools:market:build": "node scripts/build-tools-market.js",
    "license:sync-desktop-key": "node scripts/sync-desktop-license-public-key.js",
    "license:verify-desktop-config": "node scripts/verify-desktop-license-client-config.js",
    "defaults:export": "node scripts/export-default-quick-start-bundle.js && node scripts/update-default-quick-start-readme.js",
    "splash:generate": "electron scripts/generate-portable-splash.js",
    "logo:generate": "node scripts/run-platform-logo.js",
    "build:win": "npm run license:verify-desktop-config && npm run release:verify-assets && npm run build:win:setup && npm run build:win:portable",
    "build:win:setup": "electron-builder --win nsis --x64 -p never",
    "build:win:portable": "node scripts/patch-portable-nsis.js && electron-builder --win portable --x64 -p never --config.win.icon=frontend/assets/icon-windows-portable.ico",
    "build:win:publish": "npm run license:verify-desktop-config && electron-builder --win nsis --x64 --publish always && node scripts/patch-portable-nsis.js && electron-builder --win portable --x64 --publish always --config.win.icon=frontend/assets/icon-windows-portable.ico",
    "build:mac": "npm run license:verify-desktop-config && npm run release:verify-assets && node scripts/build-mac.js",
    "build:mac:local": "npm run license:verify-desktop-config && npm run release:verify-assets && node scripts/build-mac.js --local",
    "release:verify-assets": "node scripts/verify-release-assets.js",
    "promo:sync-media": "node scripts/sync-media-releases.js",
    "datacom:publish-videos": "node scripts/prepare-datacom-videos.js --write && node scripts/sync-media-releases.js --datacom",
    "datacom:verify-videos": "node scripts/prepare-datacom-videos.js && node scripts/sync-media-releases.js --datacom --check",
    "media:install-hook": "git config core.hooksPath .githooks"
  },
  "build": {
    "appId": "com.toolsplatform.app",
    "productName": "Dragon Platform",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "backend/vendor/**/*"
    ],
    "files": [
      "backend/**/*",
      "frontend/**/*",
      "desktop-pet/**/*",
      "desktop-promo/**/*",
      "scripts/generate-custom-tool-i18n.js",
      "electron-main.js",
      "electron-preload.js",
      "desktop-license-client.js",
      "desktop-machine-id.js",
      "desktop-license-preload.js",
      "desktop-local-port.js",
      "README.md",
      "!backend/{data,backups,factory-reset-archives,logs,tmp,runtime,node_modules}/**/*",
      "!backend/wal_strings.txt",
      "!frontend/assets/videos/**/*",
      "!frontend/assets/promotions/{netcare-rfc-ai-guide,operation-incentive-guide,platform-guide}{,-en}{,-hd}.mp4",
      "!frontend/assets/promotions/eos-report-guide{,-en}{,-hd}.mp4",
      "!frontend/assets/promotions/project-evolution-galaxy-hd.mp4",
      "!frontend/assets/promotions/datacom/**/*.mp4",
      "!**/.env",
      "!**/.env.*",
      "!**/*.{db,sqlite,sqlite3,db-wal,db-shm,log,p12,pfx,p8,pem,key,certSigningRequest}",
      "!backend/models/desktop-license-authority.js",
      "!backend/models/desktop-license-registry.js",
      "!backend/models/desktop-license-requests-repository.js",
      "!backend/routes/desktop-license-admin.js",
      "!backend/routes/desktop-license-public.js",
      "!backend/data/desktop-license-signing-key.json",
      "!backend/data/desktop-license-registry.json",
      "!frontend/pages/desktop-license-admin.html",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "fanxiaolongx-max",
        "repo": "privacy-policy"
      }
    ],
    "mac": {
      "icon": "frontend/assets/icon-mac.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "forceCodeSigning": true,
      "notarize": true,
      "artifactName": "Dragon-Platform-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "frontend/assets/icon-windows.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Dragon-Platform-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dragon Platform"
    },
    "portable": {
      "artifactName": "Dragon-Platform-Portable-${version}.${ext}",
      "requestExecutionLevel": "user",
      "splashImage": "frontend/assets/portable-splash.bmp"
    }
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@tutao/oxmsg": "^0.2.3",
    "acorn": "^8.17.0",
    "cors": "^2.8.5",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "jpeg-js": "^0.4.4",
    "jszip": "^3.10.1",
    "multer": "^1.4.5-lts.1",
    "pngjs": "^7.0.0",
    "sqlite3": "^6.0.1",
    "supertest": "^7.2.2",
    "uiohook-napi": "^1.5.5",
    "uuid": "^9.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "picomatch": "^4.0.4"
  }
}
