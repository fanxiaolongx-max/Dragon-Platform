def write_stats(dump_info: dict, meta: dict, slots: list) -> dict:
    dates = sorted({s["date"] for s in slots})
    mealslots = collections.Counter(s["meal"] for s in slots)
    mealdays = {m: len({s["date"] for s in slots if s["meal"] == m}) for m in MEALS}
    avgd = {}
    for m in MEALS:
        n = mealslots[m]
        avgd[m] = round(sum(len(s["dishes"]) for s in slots if s["meal"] == m) / max(1, n), 1)
    d0, d1 = dump_info["d0"], dump_info["d1"]
    ndays = (datetime.date.fromisoformat(d1) - datetime.date.fromisoformat(d0)).days + 1
    st = dict(
        rows=dump_info["rows"],
        d0=d0,
        d1=d1,
        ndays=ndays,
        msgs=meta.get("msgs", 0),
        slots=len(slots),
        dates=len(dates),
        imgonly=meta.get("imgonly", 0),
        mealslots=dict(mealslots),
        mealdays=mealdays,
        avgd=avgd,
        src=meta.get("src", {}),
    )
    atomic_write_text(WORK / "stats.json", json.dumps(st, ensure_ascii=False, indent=1))
    return st


