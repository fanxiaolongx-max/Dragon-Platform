    return menu_for_date(data, parse_date(args.day), json_mode=want_json(args))


def cmd_new(args) -> str:
    _bf, data = load_cached(args.refresh)
    mr = month_row(data, parse_month(args.month))
    mo = mr["month"]
    news = [r for r in data["rows"] if r["first"][:7] == mo]
    news.sort(key=lambda r: (-r["n"], r["first"], r["name"]))
    if want_json(args):
        return as_json({"month": mr, "count": len(news), "items": news})
    tag = "，不足月" if mr.get("partial") else ""
    lines = [f"{mo}{tag} 新菜 {fmt_int(len(news))} 道（当月首次出现，按已出现次数排序，最多列 40）"]
    if not news:
        lines.append("（无）")
        return "\n".join(lines)
    for i, r in enumerate(news[:40], 1):
        lines.append(f"{i}. {r['name']}  首次 {r['first']}  已出现 {r['n']} 次  {r['main_meal']}")
    if len(news) > 40:
        lines.append(f"另有 {len(news) - 40} 道未列出")
    return "\n".join(lines)


def cmd_status(args) -> str:
    if args.refresh:
        do_refresh(export_xlsx=False, downloads=False)
    st = {}
    if STATUS_PATH.is_file():
        try:
            st = json.loads(STATUS_PATH.read_text())
        except json.JSONDecodeError:
            st = {}
    slots_p = WORK / "slots.json"
    xlsx_guess = st.get("xlsx")
    if not xlsx_guess:
        cands = sorted(ROOT.glob("SV餐厅菜品频次清单_*.xlsx"))
        xlsx_guess = str(cands[-1]) if cands else None
    d0 = st.get("d0")
    d1 = st.get("d1")
    if not d1 and (WORK / "stats.json").is_file():
        stats = json.loads((WORK / "stats.json").read_text())
        d0, d1 = stats.get("d0"), stats.get("d1")
        st.setdefault("slots", stats.get("slots"))
        st.setdefault("msgs", stats.get("msgs"))
        st.setdefault("dates", stats.get("dates"))
        st.setdefault("rows", stats.get("rows"))
    if not d1 and slots_p.is_file():
        slots = json.loads(slots_p.read_text())["slots"]
        dates = sorted(s["date"] for s in slots)
        d0, d1 = dates[0], dates[-1]
        st.setdefault("slots", len(slots))

    if want_json(args):
        return as_json({
            **st,
            "d0": d0,
            "d1": d1,
            "mode": "online" if vault_ok() else "offline",
            "offline": not vault_ok(),
            "home": str(ROOT),
            "work": str(WORK),
            "slots_path": str(slots_p) if slots_p.is_file() else None,
            "xlsx": xlsx_guess,
        })

    last = st.get("last_refresh")
    if not last and slots_p.is_file():
        mtime = datetime.datetime.fromtimestamp(slots_p.stat().st_mtime, CAIRO)
        last = f"{mtime.strftime('%Y-%m-%d %H:%M')}（缓存文件时间，尚无 refresh 记录）"
    else:
        last = f"{last}（开罗时间）" if last else "尚无记录"

    mode = "在线（已连接微信实时仓库）" if vault_ok() else "离线（仅本地缓存）"
    lines = [
        f"数据截至：{d1 or '未知'}（开罗时间）" + (f"  起始 {d0}" if d0 else ""),
        f"上次刷新：{last}",
        f"模式：{mode}",
        f"目录：{ROOT}",
    ]
    bits = []
    if st.get("msgs"):
        bits.append(f"餐单文字 {fmt_int(st['msgs'])}")
    if st.get("slots"):
        bits.append(f"餐次 {fmt_int(st['slots'])}")
    if st.get("dates"):
        bits.append(f"覆盖 {fmt_int(st['dates'])} 天")
    if st.get("occ"):
        bits.append(f"出现 {fmt_int(st['occ'])} 次")
    if st.get("dishes"):
        bits.append(f"不同菜 {fmt_int(st['dishes'])} 道")
    if bits:
        lines.append(" ｜ ".join(bits))
    lines.append(f"表格：{xlsx_guess or '按需生成（运行 export 生成）'}")
    lines.append(f"缓存：{slots_p if slots_p.is_file() else '无 slots.json'}")
    if st.get("downloads"):
        lines.append(f"Downloads 副本：{st['downloads']}")
    return "\n".join(lines)


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="sv-menu",
        description="SV 餐厅餐单速查。默认读本地缓存，加 --refresh 会先从微信库更新缓存。",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""示例:
  sv-menu status
  sv-menu top 30 --days 30 --min-count 2 --no-staple --json
  sv-menu month
  sv-menu month 2024-07
  sv-menu months --last 6
  sv-menu dish 油条
  sv-menu top 20 --no-staple --meal 午餐
  sv-menu today
  sv-menu date 2026-11-12
  sv-menu new 2026-11
  sv-menu export --downloads""",
    )
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--refresh", action="store_true", default=argparse.SUPPRESS, help="查询前先从实时仓库更新缓存")
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS, help="输出 JSON 格式")
    p.add_argument("--refresh", action="store_true", default=argparse.SUPPRESS, help="查询前先从实时仓库更新缓存")
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS, help="输出 JSON 格式")
    sub = p.add_subparsers(dest="cmd")

    p_ref = sub.add_parser("refresh", help="从实时仓库重新解析并刷新缓存（默认不生成 Excel）", parents=[common])
    p_ref.add_argument("--export-xlsx", action="store_true", help="刷新后同时生成 Excel 频次清单")
    p_ref.add_argument("--downloads", action="store_true", help="将生成的 Excel 复制一份到 ~/Downloads")

    p_exp = sub.add_parser("export", help="基于缓存生成 Excel 频次清单", parents=[common])
    p_exp.add_argument("--out", help="指定导出文件路径或目录（默认项目目录）")
    p_exp.add_argument("--downloads", action="store_true", help="同时复制一份到 ~/Downloads")

    p_month = sub.add_parser("month", help="某月概况和 Top 10", parents=[common])
    p_month.add_argument("month", nargs="?", help="YYYY-MM，默认最新月")

    p_months = sub.add_parser("months", help="按月一览", parents=[common])
    p_months.add_argument("--last", type=int, metavar="N", help="只显示最近 N 个月")

    p_dish = sub.add_parser("dish", help="按菜名搜索", parents=[common])
    p_dish.add_argument("keyword", help="菜名关键词")

    p_top = sub.add_parser("top", help="出现次数排行", parents=[common])
    p_top.add_argument("n", nargs="?", type=int, default=15, help="条数，默认 15；传 0 或配合 --all 返回全部")
    p_top.add_argument("--meal", choices=MEALS, help="按餐次筛选")
    p_top.add_argument("--no-staple", action="store_true", help="排除常备项和饮品")
    p_top.add_argument("--month", help="只统计某月，YYYY-MM")
    p_top.add_argument("--days", type=int, metavar="N", help="只统计截止最新日期的最近 N 个自然日")
    p_top.add_argument("--min-count", type=int, default=1, metavar="N", help="只保留至少出现 N 次的菜品")
    p_top.add_argument("--all", action="store_true", help="返回全部符合条件的菜品")
    p_top.add_argument("--chart", metavar="PNG|auto", help="直接生成横向柱状图 PNG（传文件路径，或传 auto 自动保存）")

    sub.add_parser("today", help="今天各餐菜单", parents=[common])

    p_date = sub.add_parser("date", help="指定日期各餐菜单", parents=[common])
    p_date.add_argument("day", help="YYYY-MM-DD")

    p_new = sub.add_parser("new", help="某月新菜", parents=[common])
    p_new.add_argument("month", nargs="?", help="YYYY-MM，默认最新月")

    sub.add_parser("status", help="数据截止日期与文件路径", parents=[common])
    return p


def main(argv=None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    args.refresh = bool(getattr(args, "refresh", False))
    args.json = bool(getattr(args, "json", False))
    if not args.cmd:
        sys.stdout.write(USAGE)
        return 0
    handlers = {
        "refresh": cmd_refresh,
        "export": cmd_export,
        "month": cmd_month,
        "months": cmd_months,
        "dish": cmd_dish,
        "top": cmd_top,
        "today": cmd_today,
        "date": cmd_date,
        "new": cmd_new,
        "status": cmd_status,
    }
    try:
        text = handlers[args.cmd](args)
        print(text)
        return 0
    except BrokenPipeError:
        return 0
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
