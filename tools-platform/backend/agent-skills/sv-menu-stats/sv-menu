def month_row(data, month: str | None):
    rows = data["month_rows"]
    if not rows:
        die("没有按月数据。")
    if month is None:
        return rows[-1]
    for mr in rows:
        if mr["month"] == month:
            return mr
    die(f"没有 {month} 的餐单数据。有数据的月份：{rows[0]['month']} ～ {rows[-1]['month']}")


def parse_month(s: str | None) -> str | None:
    if s is None:
        return None
    try:
        datetime.datetime.strptime(s, "%Y-%m")
    except ValueError:
        die(f"月份格式应为 YYYY-MM，收到：{s}")
    return s


def parse_date(s: str) -> str:
    try:
        datetime.date.fromisoformat(s)
    except ValueError:
        die(f"日期格式应为 YYYY-MM-DD，收到：{s}")
    return s


def month_tops(data, month: str, n: int = 10, no_staple: bool = False):
    bf = import_bf()
    cnt = collections.Counter()
    for s in data.get("nslots") or []:
        if s["date"][:7] != month:
            continue
        for d in s["dishes"]:
            if no_staple and bf.is_staple_or_drink(d):
                continue
            cnt[d] += 1
    return cnt.most_common(n)


