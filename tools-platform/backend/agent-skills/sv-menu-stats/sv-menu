def unpack_bundled() -> None:
    """技能包里只放 slots.json.xz，首次使用或包内快照更新时自动解压成 slots.json"""
    global WORK, STATUS_PATH
    xz_path = SCRIPT_WORK / "slots.json.xz"
    if not xz_path.is_file():
        return
    import lzma
    import shutil

    xz_bytes = xz_path.read_bytes()
    digest = hashlib.sha256(xz_bytes).hexdigest()[:12]
    hash_file = SCRIPT_WORK / ".unpacked-hash"
    if (SCRIPT_WORK / "slots.json").is_file() and hash_file.is_file():
        try:
            if hash_file.read_text().strip() == digest:
                return
        except OSError:
            pass

    raw = lzma.decompress(xz_bytes)
    target = SCRIPT_WORK
    try:
        (target / "slots.json").write_bytes(raw)
        (target / ".unpacked-hash").write_text(digest + "\n")
    except OSError:  # 技能目录不可写时放到带内容指纹的临时缓存
        target = Path(tempfile.gettempdir()) / f"sv-menu-cache-{digest}" / "work"
        target.mkdir(parents=True, exist_ok=True)
        slots_tmp = target / "slots.json"
        mark_tmp = target / ".unpacked-hash"
        if not slots_tmp.is_file() or not mark_tmp.is_file() or mark_tmp.read_text().strip() != digest:
            slots_tmp.write_bytes(raw)
            for name in ("stats.json", "analyze_meta.json"):
                if (SCRIPT_WORK / name).is_file():
                    shutil.copy2(SCRIPT_WORK / name, target / name)
            mark_tmp.write_text(digest + "\n")
        WORK = target
        STATUS_PATH = WORK / "sv-menu-status.json"

    if not STATUS_PATH.is_file():
        try:
            snap = json.loads((WORK / "stats.json").read_text())
        except Exception:
            snap = {}
        snap_dt = datetime.datetime.fromtimestamp(xz_path.stat().st_mtime, CAIRO)
        st = dict(
            last_refresh=snap_dt.strftime("%Y-%m-%d %H:%M"),
            source="embedded-skill-snapshot",
            snapshot=snap.get("d1") or snap_dt.strftime("%Y-%m-%d"),
            offline=True,
            home=str(ROOT),
            **{k: snap.get(k) for k in ("d0", "d1", "rows", "msgs", "slots", "dates")},
        )
        try:
            STATUS_PATH.write_text(json.dumps(st, ensure_ascii=False, indent=2) + "\n")
        except OSError:
            pass


