def resolved_chart_path(chart_arg: str, tag: str) -> Path:
    arg = (chart_arg or "").strip()
    fname = f"{tag}_{now_cairo().strftime('%Y%m%d_%H%M%S')}.png"
    if not arg or arg.lower() == "auto":
        if PLATFORM_OUTPUTS.parent.is_dir() and os.access(PLATFORM_OUTPUTS.parent, os.W_OK):
            base = PLATFORM_OUTPUTS
        elif not any(part.startswith(".") for part in Path.cwd().parts if part not in (".", "/")) and os.access(Path.cwd(), os.W_OK):
            base = Path.cwd()
        else:
            base = WORK.parent if os.access(WORK.parent, os.W_OK) else Path(tempfile.gettempdir())
        base.mkdir(parents=True, exist_ok=True)
        return (base / fname).resolve()
    p = Path(arg).expanduser()
    if p.is_dir() or arg.endswith(("/", os.sep)):
        p = p / fname
    elif not p.suffix:
        p = p.with_suffix(".png")
    p.parent.mkdir(parents=True, exist_ok=True)
    return p.resolve()


def _render_top_chart_pillow(items: list[dict], title: str, subtitle: str, out_path: Path, font_path: str | None) -> Path:
    from PIL import Image, ImageDraw, ImageFont

    def load_font(sz: int):
        if font_path:
            try:
                return ImageFont.truetype(font_path, sz)
            except OSError:
                pass
        return ImageFont.load_default()

    f_title = load_font(28)
    f_sub = load_font(16)
    f_label = load_font(18)
    f_val = load_font(17)

    w = 1280
    top_pad, row_h, bot_pad = 115, 44, 48
    h = top_pad + len(items) * row_h + bot_pad
    img = Image.new("RGB", (w, h), "#FFFFFF")
    draw = ImageDraw.Draw(img)

    draw.text((48, 28), title, fill="#0F172A", font=f_title)
    draw.text((48, 68), subtitle, fill="#475569", font=f_sub)

    left_x, right_x = 290, w - 110
    bar_span = right_x - left_x
    max_val = max(x["count"] for x in items) or 1

    for idx, item in enumerate(items):
        y0 = top_pad + idx * row_h
        cy = y0 + row_h // 2
        label = f"{item['rank']}. {item['name']}"
        draw.text((left_x - 16, cy), label, fill="#1E293B", font=f_label, anchor="rm")
        bw = max(6, int(bar_span * item["count"] / max_val))
        color = "#1D4ED8" if idx < 3 else "#3B82F6"
        draw.rounded_rectangle([left_x, y0 + 8, left_x + bw, y0 + row_h - 8], radius=5, fill=color)
        draw.text((left_x + bw + 10, cy), f"{item['count']} 次", fill="#1E293B", font=f_val, anchor="lm")

    img.save(out_path, format="PNG")
    return out_path


def render_top_chart(items: list[dict], *, title: str, subtitle: str, out_path: Path) -> Path:
    font_path = find_zh_font()
    try:
        import logging
        import matplotlib

        logging.getLogger("matplotlib.font_manager").setLevel(logging.ERROR)
        matplotlib.use("Agg")
        import matplotlib.font_manager as fm
        import matplotlib.pyplot as plt
    except ImportError:
        return _render_top_chart_pillow(items, title, subtitle, out_path, font_path)

    fp_title = fm.FontProperties(fname=font_path, size=15) if font_path else None
    fp_sub = fm.FontProperties(fname=font_path, size=10.5) if font_path else None
    fp_tick = fm.FontProperties(fname=font_path, size=11) if font_path else None
    fp_val = fm.FontProperties(fname=font_path, size=10.5) if font_path else None
    if font_path:
        plt.rcParams["font.sans-serif"] = [fm.FontProperties(fname=font_path).get_name(), "sans-serif"]
    plt.rcParams["axes.unicode_minus"] = False

    n = len(items)
    fig_h = max(4.2, 1.65 + 0.44 * n)
    fig, ax = plt.subplots(figsize=(10.5, fig_h), dpi=180)
    fig.patch.set_facecolor("#FFFFFF")
    ax.set_facecolor("#FFFFFF")

    labels = [f"{it['rank']}. {it['name']}" for it in items]
    vals = [it["count"] for it in items]
    y_pos = list(range(n))
    colors = ["#1D4ED8" if i < 3 else ("#2563EB" if i < 6 else "#60A5FA") for i in range(n)]

    bars = ax.barh(y_pos, vals, height=0.66, color=colors, edgecolor="none", zorder=3)
    ax.set_yticks(y_pos)
    ax.set_yticklabels(labels, fontproperties=fp_tick, color="#0F172A")
    ax.invert_yaxis()

    max_v = max(vals) or 1
    ax.set_xlim(0, max_v * 1.18)
    ax.xaxis.grid(True, linestyle="--", alpha=0.55, color="#CBD5E1", zorder=0)
    ax.set_axisbelow(True)
    ax.spines["top"].set_visible(False)
    ax.spines["right"].set_visible(False)
    ax.spines["left"].set_color("#CBD5E1")
    ax.spines["bottom"].set_color("#CBD5E1")
    ax.tick_params(axis="x", colors="#475569", labelsize=10)
    ax.tick_params(axis="y", length=0, pad=8)

    for bar, it in zip(bars, items):
        v = it["count"]
        ax.text(
            v + max_v * 0.015,
            bar.get_y() + bar.get_height() / 2,
            f"{v} 次",
            va="center",
            ha="left",
            color="#1E293B",
            fontproperties=fp_val,
        )

    ax.set_xlabel("出现餐次数", fontproperties=fp_sub, color="#475569", labelpad=8)
    fig.suptitle(title, x=0.04, y=0.985, ha="left", va="top", color="#0F172A", fontproperties=fp_title)
    fig.text(0.04, 0.985 - (0.38 / fig_h), subtitle, ha="left", va="top", color="#64748B", fontproperties=fp_sub)

    fig.tight_layout(rect=[0.02, 0.02, 0.98, max(0.75, 1.0 - (0.88 / fig_h))])
    fig.savefig(out_path, dpi=180, facecolor="#FFFFFF")
    plt.close(fig)
    return out_path


def cmd_top(args) -> str:
    bf, data = load_cached(args.refresh)
    month = parse_month(args.month) if args.month else None
    days = args.days
    if month and days is not None:
        die("--month 和 --days 不能同时使用")
    if days is not None and days < 1:
        die("--days 必须大于等于 1")
    min_count = args.min_count if args.min_count is not None else 1
    if min_count < 1:
        die("--min-count 必须大于等于 1")
    meal = args.meal
    limit = None if (args.all or (args.n is not None and args.n <= 0)) else (args.n or 15)

    meta_map = row_by_name(data)
    d0_all, d1_all = data["d0"], data["d1"]
    win_start = d0_all
    win_end = d1_all
    win_slots = 0
    win_dates: set[str] = set()
    total_occ = 0

    if month or days is not None:
        if days is not None:
            end_dt = datetime.date.fromisoformat(d1_all)
            win_end = end_dt.isoformat()
            win_start = (end_dt - datetime.timedelta(days=days - 1)).isoformat()
        counts = collections.Counter()
        dish_dates: dict[str, set[str]] = collections.defaultdict(set)
        dish_meals: dict[str, collections.Counter] = collections.defaultdict(collections.Counter)
        dish_first: dict[str, str] = {}
        dish_last: dict[str, str] = {}

        for s in data.get("nslots") or []:
            dt = s["date"]
            if month and dt[:7] != month:
                continue
            if days is not None and not (win_start <= dt <= win_end):
                continue
            if meal and s["meal"] != meal:
                continue
            win_slots += 1
            win_dates.add(dt)
            for d in s["dishes"]:
                if args.no_staple and bf.is_staple_or_drink(d):
                    continue
                counts[d] += 1
                total_occ += 1
                dish_dates[d].add(dt)
                dish_meals[d][s["meal"]] += 1
                if d not in dish_first or dt < dish_first[d]:
                    dish_first[d] = dt
                if d not in dish_last or dt > dish_last[d]:
                    dish_last[d] = dt

        if month and win_dates:
            win_start, win_end = min(win_dates), max(win_dates)
        elif month:
            win_start = win_end = month

        matched = []
        for name, c in counts.items():
            if c < min_count:
                continue
            info = meta_map.get(name, {})
            matched.append({
                "name": name,
                "count": c,
                "days": len(dish_dates[name]),
                "meals": {m: dish_meals[name][m] for m in MEALS if dish_meals[name][m]},
                "first": dish_first[name],
                "last": dish_last[name],
                "cat": info.get("cat") or "其他/未识别",
                "staple": info.get("staple") == "是",
            })
        matched.sort(key=lambda x: (-x["count"], -x["days"], x["name"]))
    else:
        matched = []
        for s in data.get("nslots") or []:
            if meal and s["meal"] != meal:
                continue
            win_slots += 1
            win_dates.add(s["date"])
        for r in data["rows"]:
            if args.no_staple and bf.is_staple_or_drink(r["name"]):
                continue
            c = r["meals"][meal] if meal else r["n"]
            if c > 0:
                total_occ += c
            if c < min_count:
                continue
            matched.append({
                "name": r["name"],
                "count": c,
                "days": r["days"] if not meal else None,
                "meals": {m: r["meals"][m] for m in MEALS if r["meals"][m]},
                "first": r["first"],
                "last": r["last"],
                "cat": r["cat"],
                "staple": r["staple"] == "是",
            })
        matched.sort(key=lambda x: (-x["count"], -(x["days"] or 0), x["name"]))

    unique_in_window = len(matched) if min_count == 1 else sum(
        1 for _ in (counts if (month or days is not None) else matched)
    )
    shown = matched if limit is None else matched[:limit]
    for idx, item in enumerate(shown, 1):
        item["rank"] = idx

    chart_path_str: str | None = None
    if getattr(args, "chart", None) and shown:
        scope_bits = [meal or "全餐次", "已排除常备项与饮品" if args.no_staple else "含全部菜品"]
        if min_count > 1:
            scope_bits.append(f"出现>={min_count}次")
        if days is not None:
            c_title = f"SV 餐厅近 {days} 天高频菜品排行 Top {len(shown)}"
            tag = f"sv_top_{days}d"
        elif month:
            c_title = f"SV 餐厅 {month} 高频菜品排行 Top {len(shown)}"
            tag = f"sv_top_{month}"
        else:
            c_title = f"SV 餐厅历史高频菜品排行 Top {len(shown)}"
            tag = "sv_top_all"
        if meal:
            tag += f"_{meal}"
        c_sub = f"统计区间：{win_start} 至 {win_end} | {win_slots} 餐次 | " + " | ".join(scope_bits)
        c_dest = resolved_chart_path(args.chart, tag)
        render_top_chart(shown, title=c_title, subtitle=c_sub, out_path=c_dest)
        chart_path_str = str(c_dest)

    if want_json(args):
        payload = {
            "query": {
                "month": month,
                "days": days,
                "meal": meal,
                "no_staple": bool(args.no_staple),
                "min_count": min_count,
                "limit": limit,
            },
            "window": {
                "d0": d0_all,
                "d1": d1_all,
                "start": win_start,
                "end": win_end,
                "slots": win_slots,
                "dates": len(win_dates),
                "total_occ": total_occ,
                "matched_dishes": len(matched),
                "returned_count": len(shown),
            },
            "items": shown,
        }
        if chart_path_str:
            payload["chart"] = chart_path_str
        return as_json(payload)

    title_bits = []
    if days is not None:
        title_bits.append(f"近 {days} 天（{win_start} ～ {win_end}）")
    elif month:
        title_bits.append(month)
    title_bits.append(meal or "全部")
    title_bits.append("全部" if limit is None else f"Top {limit}")
    if args.no_staple:
        title_bits.append("不含常备项与饮品")
    if min_count > 1:
        title_bits.append(f"出现≥{min_count}次")
    title_bits.append(f"（匹配 {len(matched)} 道 / {win_slots} 餐次）")
    lines = [" ".join(title_bits)]

    if not shown:
        lines.append("（无）")
        return "\n".join(lines)
    for item in shown:
        lines.append(f"{item['rank']}. {item['name']}  {item['count']}")
    if chart_path_str:
        lines.append(f"图表：{chart_path_str}")
    return "\n".join(lines)


def menu_for_date(data, day: str, json_mode: bool = False) -> str:
    by_meal = {m: [] for m in MEALS}
    found = False
    for s in data.get("nslots") or []:
        if s["date"] == day:
            found = True
            by_meal[s["meal"]] = s["dishes"]
    label = f"{day}（{weekday_cn(day)}）"
    if json_mode:
        return as_json({
            "date": day,
            "weekday": weekday_cn(day),
            "found": found,
            "meals": {m: by_meal[m] for m in MEALS},
        })
    if not found:
        dates = sorted({s["date"] for s in data.get("nslots") or []})
        prev = max((d for d in dates if d < day), default=None)
        extra = f"最近一次文字餐单在 {prev}。" if prev else ""
        return f"{label} 暂无文字餐单。{extra}".rstrip()
    lines = [label]
    for m in MEALS:
        ds = by_meal[m]
        if not ds:
            lines.append(f"{m}：无文字餐单")
        else:
            lines.append(f"{m}（{len(ds)} 道）：{'、'.join(ds)}")
    return "\n".join(lines)


