def vault_ok() -> bool:
    return DECRYPTED.is_dir()


def copy_xlsx(dest: Path) -> str:
    dl = DOWNLOADS / dest.name
    try:
        import shutil

        DOWNLOADS.mkdir(parents=True, exist_ok=True)
        shutil.copy2(dest, dl)
        return str(dl)
    except OSError as e:
        return f"（复制到 Downloads 失败：{e}）"


def resolved_excel_path(d0: str, d1: str, out_path: str | Path | None = None) -> Path:
    fname = xlsx_name(d0, d1)
    if out_path:
        p = Path(out_path).expanduser()
        if p.is_dir() or str(out_path).endswith(("/", os.sep)):
            p = p / fname
        p.parent.mkdir(parents=True, exist_ok=True)
        return p.resolve()
    if os.access(ROOT, os.W_OK):
        return ROOT / fname
    fallback_dir = WORK.parent if os.access(WORK.parent, os.W_OK) else Path(tempfile.gettempdir())
    return fallback_dir / fname


def build_excel_from_cache(out_path: str | Path | None = None, downloads: bool = False) -> dict:
    slots_path = WORK / "slots.json"
    if not slots_path.is_file():
        die("没有实时仓库，也没有本地缓存。请先安装带数据的 SKILL，或在有微信库的机器上跑 sv-menu refresh。")
    if not (WORK / "stats.json").is_file():
        die("缓存不完整（缺少 stats.json）。请重新安装 SKILL 数据包，或在有微信库时跑 sv-menu refresh。")
    bf = import_bf()
    data = bf.load_and_aggregate()
    d0, d1 = data["d0"], data["d1"]
    dest = resolved_excel_path(d0, d1, out_path)
    info = bf.build(data, out_path=dest)
    dest = Path(info["out"])
    copied = copy_xlsx(dest) if downloads else None
    prev = {}
    if STATUS_PATH.is_file():
        try:
            prev = json.loads(STATUS_PATH.read_text())
        except json.JSONDecodeError:
            prev = {}
    stats = json.loads((WORK / "stats.json").read_text())
    is_offline = not vault_ok()
    status = {
        "last_refresh": prev.get("last_refresh"),
        "last_excel_build": now_str(),
        "d0": d0,
        "d1": d1,
        "rows": prev.get("rows") or stats.get("rows"),
        "msgs": prev.get("msgs") or stats.get("msgs"),
        "slots": stats.get("slots") or len(data.get("nslots") or []),
        "dates": stats.get("dates"),
        "occ": info["total_occ"],
        "dishes": info["n_dish"],
        "xlsx": str(dest),
        "downloads": copied if copied and copied.startswith("/") else prev.get("downloads"),
        "slots_path": str(slots_path),
        "home": str(ROOT),
        "offline": is_offline,
        "source": prev.get("source") or ("wechat-vault" if not is_offline else "cache"),
        "dump_last_message": prev.get("dump_last_message"),
    }
    if is_offline:
        status["note"] = "未连接微信实时仓库，仅基于本地缓存导出 Excel，数据未更新。"
    write_status(status)
    return {**status, "copied": copied}


def do_refresh(export_xlsx: bool = False, downloads: bool = False) -> dict:
    if not vault_ok():
        if export_xlsx or downloads:
            res = build_excel_from_cache(downloads=downloads)
            res["note"] = "未连接微信实时仓库，已用本地缓存重建 Excel，数据本身没有更新。"
            return res
        slots_path = WORK / "slots.json"
        if not slots_path.is_file() or not (WORK / "stats.json").is_file():
            die("没有实时仓库，也没有本地缓存。请先安装带数据的 SKILL，或在有微信库的机器上跑 sv-menu refresh。")
        bf = import_bf()
        data = bf.load_and_aggregate()
        stats = json.loads((WORK / "stats.json").read_text())
        prev = {}
        if STATUS_PATH.is_file():
            try:
                prev = json.loads(STATUS_PATH.read_text())
            except json.JSONDecodeError:
                prev = {}
        return {
            "last_refresh": prev.get("last_refresh"),
            "last_excel_build": prev.get("last_excel_build"),
            "d0": data["d0"],
            "d1": data["d1"],
            "rows": prev.get("rows") or stats.get("rows"),
            "msgs": prev.get("msgs") or stats.get("msgs"),
            "slots": stats.get("slots") or len(data.get("nslots") or []),
            "dates": stats.get("dates"),
            "occ": sum(r["n"] for r in data["rows"]),
            "dishes": len(data["rows"]),
            "xlsx": prev.get("xlsx"),
            "downloads": prev.get("downloads"),
            "slots_path": str(slots_path),
            "home": str(ROOT),
            "offline": True,
            "source": prev.get("source") or "cache",
            "dump_last_message": prev.get("dump_last_message"),
            "note": "未连接微信实时仓库，仅检查本地缓存（默认不生成 Excel、不拷贝到 Downloads）。",
        }

    WORK.mkdir(parents=True, exist_ok=True)
    dump_info = dump_messages()
    meta = run_analyze()
    slots_path = WORK / "slots.json"
    if not slots_path.is_file():
        die("解析完成但没有生成 slots.json")
    slots = json.loads(slots_path.read_text())["slots"]
    st = write_stats(dump_info, meta, slots)
    bf = import_bf()
    data = bf.load_and_aggregate()
    occ = sum(r["n"] for r in data["rows"])
    n_dish = len(data["rows"])

    prev = {}
    if STATUS_PATH.is_file():
        try:
            prev = json.loads(STATUS_PATH.read_text())
        except json.JSONDecodeError:
            prev = {}

    dest_str = prev.get("xlsx")
    last_excel_build = prev.get("last_excel_build")
    copied = None
    downloads_path = prev.get("downloads")

    if export_xlsx or downloads:
        dest = resolved_excel_path(st["d0"], st["d1"])
        info = bf.build(data, out_path=dest)
        dest = Path(info["out"])
        dest_str = str(dest)
        last_excel_build = now_str()
        if downloads:
            copied = copy_xlsx(dest)
            if copied.startswith("/"):
                downloads_path = copied

    status = {
        "last_refresh": now_str(),
        "last_excel_build": last_excel_build,
        "d0": st["d0"],
        "d1": st["d1"],
        "rows": st["rows"],
        "msgs": st["msgs"],
        "slots": st["slots"],
        "dates": st["dates"],
        "occ": occ,
        "dishes": n_dish,
        "xlsx": dest_str,
        "downloads": downloads_path,
        "slots_path": str(slots_path),
        "home": str(ROOT),
        "offline": False,
        "source": "wechat-vault",
        "dump_last_message": dump_info["t1"],
    }
    write_status(status)
    return {**status, "copied": copied}


