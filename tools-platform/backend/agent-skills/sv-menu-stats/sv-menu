def cmd_dish(args) -> str:
    _bf, data = load_cached(args.refresh)
    q = (args.keyword or "").strip()
    if not q:
        die("请给出菜名关键词，例如：sv-menu dish 油条")
    rows = [r for r in data["rows"] if q in r["name"]]
    if not rows:
        if want_json(args):
            return as_json({"keyword": q, "count": 0, "items": []})
        return f"没有找到含「{q}」的菜。"
    rows.sort(key=lambda r: -r["n"])
    d1 = data["d1"]
    # last 6 months ending at d1
    y, m = int(d1[:4]), int(d1[5:7])
    last6 = []
    for _ in range(6):
        last6.append(f"{y:04d}-{m:02d}")
        m -= 1
        if m <= 0:
            m = 12
            y -= 1
    last6.reverse()

    # monthly counts for shown dishes
    want = {r["name"] for r in rows[:20]}
    monthly = {name: collections.Counter() for name in want}
    for s in data.get("nslots") or []:
        mo = s["date"][:7]
        if mo not in last6:
            continue
        for d in s["dishes"]:
            if d in monthly:
                monthly[d][mo] += 1

    def detail(r) -> list[str]:
        meal_s = "  ".join(f"{m} {r['meals'][m]}" for m in MEALS if r["meals"][m])
        staple = " ｜ 常备项" if r["staple"] == "是" else ""
        trend = "  ".join(f"{mo[5:]}月 {monthly[r['name']][mo]}" for mo in last6)
        return [
            r["name"],
            f"出现 {fmt_int(r['n'])} 次 ｜ {fmt_int(r['days'])} 天 ｜ 日覆盖 {fmt_pct(r['day_cover'])} ｜ 主餐次 {r['main_meal']}{staple}",
            f"{r['cat']} ｜ {r['hs']} ｜ {r['first']}～{r['last']} ｜ {r['status']}",
            f"餐次：{meal_s}" if meal_s else "餐次：—",
            f"近 6 个月：{trend}",
        ]

    # exact match first if any
    exact = [r for r in rows if r["name"] == q]
    others = [r for r in rows if r["name"] != q]
    ordered = exact + others
    if want_json(args):
        return as_json({
            "keyword": q,
            "count": len(ordered),
            "last6_months": last6,
            "items": [
                {**r, "last6": {mo: monthly[r["name"]][mo] for mo in last6}}
                if r["name"] in monthly else r
                for r in ordered[:20]
            ],
        })
    lines: list[str] = []
    if len(ordered) == 1:
        return "\n".join(detail(ordered[0]))
    lines.append(f"共 {len(ordered)} 道菜名含「{q}」，按次数排序" + ("（只列前 20）" if len(ordered) > 20 else ""))
    for r in ordered[:20]:
        if r["name"] == q or len(exact) == 0 and r is ordered[0]:
            if lines and lines[-1] != "":
                lines.append("")
            lines.extend(detail(r))
            lines.append("")
        else:
            lines.append(f"· {r['name']}  {r['n']} 次  {r['first']}～{r['last']}  {r['main_meal']}")
    if len(ordered) > 20:
        lines.append(f"另有 {len(ordered) - 20} 道未列出")
    return "\n".join(lines).rstrip()


