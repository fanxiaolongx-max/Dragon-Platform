        die(f"找不到解密库目录：{msgdir}。请确认实时同步在运行。")
    dbs = sorted(
        p
        for p in msgdir.glob("message_*.db")
        if p.is_file() and "fts" not in p.name and "resource" not in p.name
    )
    if not dbs:
        die(f"{msgdir} 里没有 message_*.db")
    return dbs


def dump_messages() -> dict:
    import zstandard

    z = zstandard.ZstdDecompressor()
    names = load_names()
    out: dict[str, dict] = {}
    shards = 0
    for db in message_dbs():
        con = open_db(db)
        try:
            tabs = {r[0] for r in con.execute("select name from sqlite_master where type='table'")}
            if TABLE not in tabs or "Name2Id" not in tabs:
                continue
            shards += 1
            n2i = {r: u for r, u in con.execute("select rowid, user_name from Name2Id")}
            sql = (
                f"select local_id,server_id,local_type,real_sender_id,"
                f"create_time,message_content,WCDB_CT_message_content from {TABLE}"
            )
            for lid, sid, lt, rs, ct, mc, cf in con.execute(sql):
                txt = dec_text(mc, cf, z)
                u = n2i.get(rs, "")
                if u and txt.startswith(u + ":\n"):
                    txt = txt[len(u) + 2 :]
                key = str(sid or f"{db.name}:{lid}")
                dt = datetime.datetime.fromtimestamp(ct, CAIRO)
                typ = lt & 0xFFFFFFFF
                body = txt if typ in (1, 49, 10000) else ""
                out[key] = dict(
                    t=dt.strftime("%Y-%m-%d %H:%M:%S"),
                    type=typ,
                    sender=names.get(u, u),
                    wxid=u,
                    text=body,
                )
        finally:
            con.close()
    if not out:
        die("没有读到 SV 群消息。请确认实时仓库已解密，且群表仍在。")
    rows = sorted(out.values(), key=lambda r: r["t"])
    buf = "".join(json.dumps(r, ensure_ascii=False) + "\n" for r in rows)
    atomic_write_text(WORK / "all.jsonl", buf)
    return {
        "rows": len(rows),
        "d0": rows[0]["t"][:10],
        "d1": rows[-1]["t"][:10],
        "t0": rows[0]["t"],
        "t1": rows[-1]["t"],
        "shards": shards,
    }


