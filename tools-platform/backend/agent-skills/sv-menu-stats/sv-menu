def atomic_write_text(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=path.name + ".", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def open_db(path: Path) -> sqlite3.Connection:
    uri = f"file:{path}?mode=ro"
    try:
        con = sqlite3.connect(uri, uri=True, timeout=20)
        con.execute("select 1").fetchone()
        return con
    except sqlite3.Error:
        return sqlite3.connect(str(path), timeout=20)


def load_names() -> dict[str, str]:
    names: dict[str, str] = {}
    contact = DECRYPTED / "contact" / "contact.db"
    if not contact.is_file():
        return names
    con = open_db(contact)
    try:
        for tb in ("stranger", "contact"):
            try:
                for u, r, n in con.execute(f"select username,remark,nick_name from {tb}"):
                    names[u] = r or n or u
            except sqlite3.Error:
                continue
    finally:
        con.close()
    return names


def dec_text(v, flag, zstd) -> str:
    if v is None:
        return ""
    if isinstance(v, str):
        return v
    b = bytes(v)
    if b[:4] == b"\x28\xb5\x2f\xfd" or flag == 4:
        try:
            b = zstd.decompress(b, max_output_size=2_000_000)
        except Exception:
            return ""
    return b.decode("utf-8", "replace")


def message_dbs() -> list[Path]:
